<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>assign Status = &quot;Canceled&quot; and Description = &quot;Abandoned Cart&quot; to current Gift Transaction to be updated at the end of the Flow</description>
        <name>assignGiftTransactionValues</name>
        <label>assignGiftTransactionValues</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>loopGiftTransactions.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>loopGiftTransactions.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Abandoned Cart</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCollection_GiftTransactionsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>loopGiftTransactions</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopGiftTransactions</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>if the Gift Transaction has been in Status = &quot;Pending&quot; for at least 1 day, send to assign new values</description>
        <name>checkTimeSincePending</name>
        <label>checkTimeSincePending</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>loopGiftTransactions</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Less than 1 Day</defaultConnectorLabel>
        <rules>
            <name>Past1Day</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>form_TimeSincePending</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignGiftTransactionValues</targetReference>
            </connector>
            <label>Past 1 Day</label>
        </rules>
    </decisions>
    <description>Scheduled Flow to find and update credit card Gift Transactions created through FinDock that have been Abandoned (in Pending Status for at least 1 day).</description>
    <environments>Default</environments>
    <formulas>
        <name>form_TimeSincePending</name>
        <dataType>Number</dataType>
        <expression>{!$Flow.CurrentDateTime}-{!loopGiftTransactions.CreatedDate}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>FinDock Labs - Abandoned Cart Status Update (Scheduled) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FinDock Labs - Abandoned Cart Status Update (Scheduled)</label>
    <loops>
        <description>loop through the Gift Transactions to see how long they have been in Status = &quot;Pending&quot;</description>
        <name>loopGiftTransactions</name>
        <label>loopGiftTransactions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getGiftTransactionsPending</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>checkTimeSincePending</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>updateAbandonedGiftTransactions</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>get all Gift Transactions that are in Status = &quot;Pending&quot; that were created by the FinDock Integration User using Credit Card as a Payment Method</description>
        <name>getGiftTransactionsPending</name>
        <label>getGiftTransactionsPending</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>loopGiftTransactions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedById</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>005a5000002NDg9AAG</stringValue>
            </value>
        </filters>
        <filters>
            <field>fdff__Payment_Method__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CreditCard</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>update Gift Transactions that have been in Status = &quot;Pending&quot; over 1 day to the values assigned in Loop</description>
        <name>updateAbandonedGiftTransactions</name>
        <label>updateAbandonedGiftTransactions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varCollection_GiftTransactionsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getGiftTransactionsPending</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-10-31</startDate>
            <startTime>17:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCollection_GiftTransactionsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>GiftTransaction</objectType>
    </variables>
</Flow>
